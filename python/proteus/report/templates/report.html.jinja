<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Proteus Simulation Report — {{ simulation_id }}</title>
<style>
  :root {
    --fg: #1b1f24;
    --muted: #57606a;
    --border: #d0d7de;
    --bg-soft: #f6f8fa;
    --pass: #1a7f37;
    --fail: #cf222e;
    --skip: #9a6700;
    --accent: #0969da;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 32px 24px 64px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: var(--fg);
    line-height: 1.55;
    max-width: 1080px;
    margin-inline: auto;
  }
  h1 { font-size: 1.9rem; margin: 0 0 4px; }
  h2 { font-size: 1.25rem; margin: 32px 0 12px; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
  h3 { font-size: 1.02rem; margin: 18px 0 8px; }
  .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 24px; }
  code, .mono { font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace; font-size: 0.86em; }
  table { border-collapse: collapse; width: 100%; margin: 8px 0 16px; font-size: 0.9rem; }
  th, td { border: 1px solid var(--border); padding: 6px 10px; text-align: left; vertical-align: top; }
  th { background: var(--bg-soft); font-weight: 600; }
  .cards { display: flex; gap: 12px; flex-wrap: wrap; margin: 12px 0 8px; }
  .card {
    flex: 1 1 180px; border: 1px solid var(--border); border-radius: 8px;
    padding: 12px 16px; background: var(--bg-soft);
  }
  .card .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .card .value { font-size: 1.35rem; font-weight: 600; margin-top: 2px; }
  .verdict-VIABLE { color: var(--pass); }
  .verdict-NON_VIABLE { color: var(--fail); }
  .verdict-UNCERTAIN { color: var(--skip); }
  .badge {
    display: inline-block; padding: 1px 8px; border-radius: 999px;
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .badge-pass { background: #dafbe1; color: var(--pass); }
  .badge-fail { background: #ffebe9; color: var(--fail); }
  .badge-skip { background: #fff8c5; color: var(--skip); }
  .badge-other { background: #eaeef2; color: var(--muted); }
  .bar { height: 8px; background: #eaeef2; border-radius: 999px; overflow: hidden; margin-top: 6px; }
  .bar > span { display: block; height: 100%; background: var(--accent); }
  ul.tight { margin: 6px 0; padding-left: 22px; }
  ul.tight li { margin: 2px 0; }
  .notice {
    border-left: 4px solid var(--skip); background: #fff8c5;
    padding: 12px 16px; border-radius: 4px; margin: 12px 0;
  }
  .notice strong { display: block; margin-bottom: 4px; }
  .viz-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(430px, 1fr));
    gap: 18px; margin: 14px 0 20px;
  }
  .viz-grid figure { margin: 0; }
  .viz-grid img {
    width: 100%; height: auto; display: block; border: 1px solid var(--border);
    border-radius: 8px; background: white;
  }
  .viz-grid figcaption { font-size: 0.82rem; color: var(--muted); margin-top: 6px; }
  details { margin: 6px 0; }
  summary { cursor: pointer; color: var(--accent); }
  pre {
    background: var(--bg-soft); border: 1px solid var(--border); border-radius: 6px;
    padding: 10px 12px; overflow-x: auto; font-size: 0.82rem; white-space: pre-wrap;
    word-break: break-word; max-height: 340px;
  }
  .muted { color: var(--muted); }
  footer { margin-top: 40px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 0.8rem; color: var(--muted); }
</style>
</head>
<body>

<h1>Proteus Simulation Report</h1>
<div class="meta">
  Simulation <code>{{ simulation_id }}</code> · generated {{ generated_at }}<br>
  Reference: <code>{{ reference_uri }}</code>
  {% if reference_hash %} · content hash <code>{{ reference_hash }}</code>{% endif %}
</div>

<h2>Run summary</h2>
<div class="cards">
  <div class="card">
    <div class="label">Viability verdict</div>
    <div class="value verdict-{{ viability.verdict }}">{{ viability.verdict }}</div>
    <div class="bar"><span style="width: {{ (viability.composite * 100) | round(1) }}%"></span></div>
    <div class="muted mono">{{ "%.4f" | format(viability.composite) }} composite · confidence {{ "%.2f" | format(viability.confidence) }}</div>
  </div>
  <div class="card">
    <div class="label">Variants applied</div>
    <div class="value">{{ variants | length }}</div>
    <div class="muted">event-sourced overlays</div>
  </div>
  <div class="card">
    <div class="label">Validation layers</div>
    <div class="value">
      {{ validation | selectattr("status", "equalto", "pass") | list | length }}/{{ validation | length }}
    </div>
    <div class="muted">V1–V7 passing</div>
  </div>
  <div class="card">
    <div class="label">Revert check</div>
    <div class="value">{{ "EXACT" if baseline_hash == reverted_hash else "MISMATCH" }}</div>
    <div class="muted mono">{{ reverted_hash[:16] if reverted_hash else "n/a" }}</div>
  </div>
</div>

{% if viability.failed_gates %}
<div class="notice">
  <strong>Hard viability gates failed</strong>
  <ul class="tight">
    {% for gate in viability.failed_gates %}<li><code>{{ gate }}</code></li>{% endfor %}
  </ul>
</div>
{% endif %}

<h2>Applied variants</h2>
{% if variants %}
<table>
  <thead>
    <tr><th>ID</th><th>Type</th><th>Contig</th><th>Start</th><th>End</th><th>Change</th><th>Source</th></tr>
  </thead>
  <tbody>
    {% for v in variants %}
    <tr>
      <td><code>{{ v.id }}</code></td>
      <td>{{ v.type }}</td>
      <td>{{ v.contig }}</td>
      <td>{{ v.start }}</td>
      <td>{{ v.end }}</td>
      <td><code>{{ v.ref }} → {{ v.alt }}</code></td>
      <td>{{ v.source }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="muted">No variants were applied in this run.</p>
{% endif %}

{% if visualizations %}
<h2>Molecular visuals</h2>
<p class="muted">
  Figures generated from the same run data. The genome browser and helix show the
  reference sequence and injected lesions; the central-dogma panel translates codons
  directly from that sequence. Full-resolution files are in
  <code>visualizations/</code>.
</p>
<div class="viz-grid">
  {% for viz in visualizations %}
  <figure>
    <img src="{{ viz.path }}" alt="{{ viz.title }}" loading="lazy">
    <figcaption><strong>{{ viz.title }}</strong>{% if viz.caption %}<br>{{ viz.caption }}{% endif %}</figcaption>
  </figure>
  {% endfor %}
</div>
{% endif %}

<h2>Viability decomposition</h2>
<table>
  <thead>
    <tr><th>Layer</th><th>Score</th><th>Weight</th><th>Weighted contribution</th></tr>
  </thead>
  <tbody>
    {% for layer, score in viability.layer_scores.items() %}
    <tr>
      <td>{{ layer }}</td>
      <td>{{ "%.4f" | format(score) }}</td>
      <td>{{ "%.2f" | format(viability.weights.get(layer, 0.0)) }}</td>
      <td>{{ "%.4f" | format(score * viability.weights.get(layer, 0.0)) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if viability.survival_window_h is not none or viability.point_of_no_return_h is not none or viability.irreversible_events or viability.hard_gate_failures %}
<h2>Time-dynamic viability assessment</h2>
<div class="cards">
  {% if viability.survival_window_h is not none %}
  <div class="card">
    <div class="label">Survival window</div>
    <div class="value">{{ "%.2f" | format(viability.survival_window_h) }} h</div>
    <div class="muted">estimated from irreversible damage thresholds</div>
  </div>
  {% endif %}
  {% if viability.point_of_no_return_h is not none %}
  <div class="card">
    <div class="label">Point of no return</div>
    <div class="value">{{ "%.2f" | format(viability.point_of_no_return_h) }} h</div>
    <div class="muted">first irreversible event</div>
  </div>
  {% endif %}
  {% if viability.irreversible_events %}
  <div class="card">
    <div class="label">Irreversible events</div>
    <div class="value">{{ viability.irreversible_events | length }}</div>
    <div class="muted">cumulative damage events</div>
  </div>
  {% endif %}
</div>

{% if viability.irreversible_events %}
<h3>Irreversible event log</h3>
<table>
  <thead>
    <tr><th>Time (h)</th><th>Type</th><th>Severity</th><th>Description</th></tr>
  </thead>
  <tbody>
    {% for event in viability.irreversible_events %}
    <tr>
      <td>{{ "%.2f" | format(event.time) }}</td>
      <td>{{ event.type }}</td>
      <td>{{ "%.2f" | format(event.severity) }}</td>
      <td>{{ event.description }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if viability.swap_gate_results and viability.swap_gate_results.gate_results %}
<h3>Swap gate results</h3>
<table>
  <thead>
    <tr><th>Gate</th><th>Result</th><th>Score</th><th>Message</th></tr>
  </thead>
  <tbody>
    {% for gate_name, gate_result in viability.swap_gate_results.gate_results.items() %}
    {% if gate_result is mapping %}
    <tr>
      <td>{{ gate_name }}</td>
      <td>{{ gate_result.result }}</td>
      <td>{{ "%.3f" | format(gate_result.score) }}</td>
      <td>{{ gate_result.message }}</td>
    </tr>
    {% endif %}
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if viability.hard_gate_failures %}
<h3>Hard gate failures</h3>
<ul class="tight">
  {% for gate in viability.hard_gate_failures %}<li><code>{{ gate }}</code></li>{% endfor %}
</ul>
{% endif %}

{% endif %}

{% if revert_hysteresis and revert_hysteresis.available %}
<h2>Revert outcome: genome vs phenotype</h2>
<div class="cards">
  <div class="card">
    <div class="label">Genome revert</div>
    <div class="value">{{ "EXACT" if revert_hysteresis.genome_revert_exact else "MISMATCH" }}</div>
    <div class="muted">event-sourced overlay removal</div>
  </div>
  <div class="card">
    <div class="label">Phenotype</div>
    <div class="value">{{ "RESTORED" if revert_hysteresis.phenotype_matches_baseline else "RESIDUAL DAMAGE" }}</div>
    <div class="muted">post-revert time-dynamic simulation</div>
  </div>
  <div class="card">
    <div class="label">Hysteresis index</div>
    <div class="value">{{ "%.3f" | format(revert_hysteresis.hysteresis_index or 0.0) }}</div>
    <div class="muted">0 = no residual damage, 1 = maximal</div>
  </div>
</div>

{% if revert_hysteresis.residual_damage %}
<h3>Persistent damage after revert</h3>
<table>
  <thead>
    <tr><th>Damage type</th><th>Residual severity</th></tr>
  </thead>
  <tbody>
    {% for dtype, severity in revert_hysteresis.residual_damage.items() %}
    <tr>
      <td>{{ dtype }}</td>
      <td>{{ "%.3f" | format(severity) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if revert_hysteresis.post_revert_tissue_viability %}
<h3>Post-revert mean tissue viability</h3>
<table>
  <thead>
    <tr><th>Tissue</th><th>Mean viability</th></tr>
  </thead>
  <tbody>
    {% for tissue, value in revert_hysteresis.post_revert_tissue_viability.items() %}
    <tr>
      <td>{{ tissue }}</td>
      <td>{{ "%.3f" | format(value) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}
{% endif %}

<h2>Layer diffs (L0–L4)</h2>
<table>
  <thead>
    <tr><th>Layer</th><th>Added</th><th>Removed</th><th>Changed</th></tr>
  </thead>
  <tbody>
    {% for d in diffs %}
    <tr>
      <td>{{ d.layer }}</td>
      <td>{{ d.added_count }}</td>
      <td>{{ d.removed_count }}</td>
      <td>{{ d.changed_count }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h2>Validation layers V1–V7</h2>
<table>
  <thead>
    <tr><th>Layer</th><th>Status</th><th>Message</th><th>Details</th></tr>
  </thead>
  <tbody>
    {% for c in validation %}
    <tr>
      <td><strong>{{ c.name }}</strong></td>
      <td>
        {% if c.status == "pass" %}<span class="badge badge-pass">pass</span>
        {% elif c.status == "fail" %}<span class="badge badge-fail">fail</span>
        {% elif c.status == "skip" %}<span class="badge badge-skip">skip</span>
        {% else %}<span class="badge badge-other">{{ c.status }}</span>{% endif %}
      </td>
      <td>{{ c.message }}</td>
      <td>
        {% if c.details %}
        <details><summary>show</summary><pre>{{ c.details | tojson(indent=2) }}</pre></details>
        {% else %}<span class="muted">—</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if layers %}
<h2>Layer payloads</h2>
{% for name, payload in layers.items() %}
<details>
  <summary><strong>{{ name }}</strong></summary>
  <pre>{{ payload | tojson(indent=2) }}</pre>
</details>
{% endfor %}
{% endif %}

<h2>Evidence chains</h2>
{% if evidence %}
<table>
  <thead>
    <tr><th>Claim</th><th>Tool</th><th>Confidence</th><th>Validation</th><th>Params</th></tr>
  </thead>
  <tbody>
    {% for e in evidence %}
    <tr>
      <td>{{ e.claim }}</td>
      <td><code>{{ e.tool }}</code></td>
      <td>{{ e.confidence }}</td>
      <td>{{ e.validation_passes | join(", ") if e.validation_passes else "—" }}</td>
      <td>
        {% if e.params %}
        <details><summary>show</summary><pre>{{ e.params | tojson(indent=2) }}</pre></details>
        {% else %}<span class="muted">—</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="muted">No evidence chains recorded.</p>
{% endif %}

<h2>Content addressing and reproducibility</h2>
<table>
  <tbody>
    <tr><th>Baseline state</th><td class="mono">{{ baseline_hash or "n/a" }}</td></tr>
    <tr><th>Mutated state</th><td class="mono">{{ mutated_hash or "n/a" }}</td></tr>
    <tr><th>Reverted state</th><td class="mono">{{ reverted_hash or "n/a" }}</td></tr>
    <tr><th>Revert exact</th><td>{{ "yes" if baseline_hash == reverted_hash else "no" }}</td></tr>
    <tr><th>Provenance manifest</th><td class="mono">{{ provenance or "n/a" }}</td></tr>
    <tr><th>Generated with</th><td class="mono">{{ environment.python }} on {{ environment.platform }}</td></tr>
  </tbody>
</table>

<h2>Limitations</h2>
<div class="notice">
  <strong>Scientific scope and explicit limitations</strong>
  <ul class="tight">
    {% for limitation in limitations %}<li>{{ limitation }}</li>{% endfor %}
  </ul>
</div>

<footer>
  Generated by Proteus · report formats: HTML, PDF, LaTeX, JSON-LD, RO-Crate ·
  this document is a computational artifact, not medical advice.
</footer>

</body>
</html>
